		{
			"name": "2. Demo Payroll Processing",
			"item": [
				{
					"name": "Step 1: Generate Payroll (Draft Run)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    let data = pm.response.json();",
									"    if (data.payrollRunId) {",
									"        pm.collectionVariables.set('runId', data.payrollRunId);",
									"        console.log('Set runId to:', data.payrollRunId);",
									"    }",
									"    if (data.records && data.records.length > 0) {",
									"        pm.collectionVariables.set('recordId', data.records[0].payrollRecordId);",
									"        console.log('Set recordId to:', data.records[0].payrollRecordId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrf_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/payroll/generate?year=2026&month=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payroll",
								"generate"
							],
							"query": [
								{
									"key": "year",
									"value": "2026"
								},
								{
									"key": "month",
									"value": "10"
								}
							]
						},
						"description": "Calculates gross salary, deductions, and net salary for all active employees and creates a draft payroll run (Status: GENERATED). Automatically saves `runId` and `recordId` into collection variables."
					},
					"response": []
				},
				{
					"name": "Step 2: Approve Payroll (Finance)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrf_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/payroll/{{runId}}/approve",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payroll",
								"{{runId}}",
								"approve"
							]
						},
						"description": "Finance reviews and approves the draft payroll run (Status becomes: FINANCE_APPROVED)."
					},
					"response": []
				},
				{
					"name": "Step 3: Execute Demo Payout (Direct Deposit)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-XSRF-TOKEN",
								"value": "{{xsrf_token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/payroll/{{runId}}/payout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"payroll",
								"{{runId}}",
								"payout"
							]
						},
						"description": "Executes simulated direct bank deposit payout using employee IFSC and bank accounts. Generates mock UTR reference IDs, PaymentTransaction records, itemized Payslips, and marks run as PAID."
					},
					"response": []
				},
